{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "console/**/*.ts",
    "console/**/*.tsx",
    "control-plane/**/*.ts",
    "website/**/*.ts",
    "website/**/*.tsx",
    "backend/**/*.ts",
    "sdk/web/**/*.ts",
    "sdk/web/**/*.tsx",
    "services/autopilot/**/*.ts",
    "Test Apps/web/apex-sandbox-web/**/*.ts",
    "Test Apps/web/apex-sandbox-web/**/*.tsx"
  ]
}
