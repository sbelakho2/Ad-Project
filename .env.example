# Apex Mediation Platform - Environment Configuration Template
# Copy this file to .env and fill in the values for your environment.
# This file is committed to version control as a template; .env files are gitignored.

# =============================================================================
# CORE APPLICATION
# =============================================================================
NODE_ENV=development                          # development | staging | production
PORT=3000                                     # Backend API port
LOG_LEVEL=info                                # debug | info | warn | error

# =============================================================================
# DATABASE (PostgreSQL 16+)
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/apexmediation
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false                            # true for production

# =============================================================================
# REDIS (7.x)
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=                               # Optional: Set for production

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRES_IN=24h
SESSION_SECRET=change-me-to-another-secure-random-string

# Two-Factor Authentication
TOTP_ISSUER=ApexMediation
TOTP_SECRET_ENCRYPTION_KEY=32-char-encryption-key-here

# =============================================================================
# STRIPE BILLING (API version 2025-10-29)
# =============================================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Usage-based billing
STRIPE_METERED_PRICE_ID=price_...             # Metered usage price ID
STRIPE_BASE_PRICE_ID=price_...                # Platform fee price ID

# =============================================================================
# AD NETWORK CREDENTIALS (BYO Model - Publisher Provided)
# =============================================================================
# These are optional - publishers provide their own credentials via Console

# AdMob (for server-side reporting)
# ADMOB_CLIENT_ID=
# ADMOB_CLIENT_SECRET=
# ADMOB_REFRESH_TOKEN=

# AppLovin
# APPLOVIN_API_KEY=

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Email (SendGrid / SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.your-sendgrid-api-key
EMAIL_FROM=noreply@apexmediation.ee

# Email (Resend - Sales Automation)
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=

# Sentry Error Tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# =============================================================================
# OBSERVABILITY & MONITORING
# =============================================================================
PROMETHEUS_COLLECT_DEFAULTS=1                 # Enable default Node.js metrics
PROMETHEUS_CLUSTER_LABEL=apex-production
PROMETHEUS_ENVIRONMENT_LABEL=production

# Grafana
GRAFANA_ADMIN_PASSWORD=change-me

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_VRA_ENABLED=true                      # Verifiable Revenue Attribution
FEATURE_FRAUD_DETECTION_ENABLED=true          # ML-based fraud detection
FEATURE_SSAI_ENABLED=true                     # Server-Side Ad Insertion
FEATURE_MIGRATION_STUDIO_ENABLED=true         # Migration import tools

# Sales Automation (Autonomous)
SALES_AUTOMATION_ENABLED=false
SALES_AUTOMATION_CRON=*/30 * * * *
SALES_AUTOMATION_RUN_ON_STARTUP=false
SALES_AUTOMATION_DEFAULT_MAILBOX=sales@apexmediation.ee
SALES_AUTOMATION_MAX_DAILY_EMAILS=100
SALES_AUTOMATION_SELF_LEARNING_ENABLED=true
SALES_AUTOMATION_AUTONOMOUS_MODE=true

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=60000                    # 1 minute window
RATE_LIMIT_MAX_REQUESTS=100                   # Max requests per window
RATE_LIMIT_AUTH_MAX=10                        # Auth endpoint limit (stricter)

# =============================================================================
# SSAI (Server-Side Ad Insertion)
# =============================================================================
SSAI_SESSION_TTL_SECONDS=3600                 # 1 hour default
SSAI_MAX_SESSIONS_PER_TENANT=10000
SSAI_BEACON_TIMEOUT_MS=5000

# =============================================================================
# CORS & API
# =============================================================================
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
API_BASE_URL=https://api.apexmediation.ee

# =============================================================================
# DEPLOYMENT TARGETS (for live testing)
# =============================================================================
# See .env.live.example for live E2E test configuration
