[Unit]
Description=Apex E2E Canary Verify (Test Server)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/adproject
EnvironmentFile=/opt/adproject/.env.slo
ExecStart=/opt/adproject/scripts/ops/e2e_canary_verify.sh
StandardOutput=append:/var/log/e2e_canary_verify.log
StandardError=inherit
