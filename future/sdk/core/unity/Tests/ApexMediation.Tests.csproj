<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Set UNITY_RUNNER=true in a Unity editor/CI environment to actually build and run these tests -->
    <UnityRunner Condition="'$(UNITY_RUNNER)' != ''">true</UnityRunner>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsTestProject Condition="'$(UnityRunner)' != 'true'">false</IsTestProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(UnityRunner)' == 'true'">
    <!-- The runtime compiles as its own project so coverlet can instrument it. -->
    <Compile Include="**/*.cs" />
    <Compile Remove="obj/**/*.cs" />
    <Compile Remove="bin/**/*.cs" />
    <!-- UnityStubs.cs belongs to ApexMediation.Runtime (single definition of the UnityEngine
         types; compiling it here as well caused CS0436 conflicts across the two assemblies). -->
    <Compile Remove="UnityStubs.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(UnityRunner)' == 'true'">
    <ProjectReference Include="../Runtime/ApexMediation.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UnityRunner)' != 'true'">
    <Compile Remove="**/*.cs" />
  </ItemGroup>

  <!-- When not running under Unity, skip compiling runtime sources to avoid UnityEngine dependency errors -->
  <Target Name="SkipIfNotUnity" BeforeTargets="Compile" Condition="'$(UnityRunner)' != 'true'">
    <Message Text="UNITY_RUNNER not set; skipping Unity test build (UnityEngine not available)." Importance="High" />
    <ItemGroup>
      <Compile Remove="**/*.cs" />
    </ItemGroup>
  </Target>

  <Target Name="SkipTestExecutionWhenNotUnity" BeforeTargets="VSTest" Condition="'$(UnityRunner)' != 'true'">
    <Message Text="UNITY_RUNNER not set; skipping test execution." Importance="High" />
    <PropertyGroup>
      <RunTests>false</RunTests>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.8" />
    <!-- Coverage for the tier-1 (no-editor) gate: enables /p:CollectCoverage. -->
    <PackageReference Include="coverlet.msbuild" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The suite intentionally mixes xunit and NUnit (NUnit matches the Unity Test Framework
         dialect used by Il2CppCompatibilityTests); both adapters run under dotnet test. -->
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
