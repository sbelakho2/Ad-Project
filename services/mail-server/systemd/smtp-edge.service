[Unit]
Description=ApexMediation SMTP Edge Service
After=network.target mailstore-core.service
Wants=mailstore-core.service

[Service]
Type=simple
User=apex-mail
Group=apex-mail
WorkingDirectory=/opt/apex-mail
Environment="RUST_LOG=info"
EnvironmentFile=/opt/apex-mail/.env
ExecStart=/opt/apex-mail/bin/smtp-edge --listen 0.0.0.0:25 --hostname mail.apexmediation.ee
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

# Allow binding to privileged port
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Resource limits
LimitNOFILE=65535
MemoryMax=1G

[Install]
WantedBy=multi-user.target
