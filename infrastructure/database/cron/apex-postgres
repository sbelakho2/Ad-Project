# /etc/cron.d/apex-postgres
# Automated DB maintenance for ApexMediation DB server
# Install via: infrastructure/database/install_db_automation.sh

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Health check (every 5 minutes)
*/5 * * * * root /usr/local/bin/pg_autonomous_health.sh

# Disk space check (every hour)
0 * * * * root /usr/local/bin/check-disk-space.sh

# WAL archive cleanup (daily 04:00)
0 4 * * * root /usr/local/bin/pg_wal_cleanup.sh

# Logical backup (daily 03:00) - runs as postgres
0 3 * * * postgres /usr/local/bin/pg_backup_apex.sh

# Physical base backup for PITR (weekly Sunday 01:00) - runs as postgres
0 1 * * 0 postgres /usr/local/bin/pg_basebackup_apex.sh
