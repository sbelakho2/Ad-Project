# Edge Worker Service - ML Inference for Autonomous Sales
# 
# This service runs on the Test Server (157.90.126.205) and handles:
#   - Icebreaker message generation (LLM-powered)
#   - Hybrid email classification
#   - Reputation analysis
#   - Web scraping with Playwright
# 
# The Edge Worker communicates with the Control Plane on the App Server
# via REST API, authenticated with a shared secret.
# 
# Installation:
#   sudo cp edge-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable edge-worker
#   sudo systemctl start edge-worker
# 
# Logs:
#   sudo journalctl -u edge-worker -f

[Unit]
Description=Edge Worker Service - ML Inference for Autonomous Sales
Documentation=https://github.com/your-org/Ad-Project
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# Working directory
WorkingDirectory=/opt/edge-worker

# Environment
Environment=NODE_ENV=production
EnvironmentFile=/opt/edge-worker/.env

# Start command
ExecStart=/usr/bin/node dist/index.js

# Restart policy
Restart=always
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3

# Output
StandardOutput=journal
StandardError=journal
SyslogIdentifier=edge-worker

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Memory limit (prevent runaway ML models)
MemoryMax=4G
MemoryHigh=3G

# CPU scheduling
CPUWeight=100
Nice=-5

# Security hardening (optional, uncomment if needed)
# NoNewPrivileges=true
# ProtectSystem=strict
# ProtectHome=true
# PrivateTmp=true
# ReadWritePaths=/opt/edge-worker

# Watchdog
WatchdogSec=60
NotifyAccess=main

# Graceful shutdown
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
