[Unit]
Description=ApexMediation Inbound SMTP Server
Documentation=https://github.com/apexmediation/ad-project
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/adproject/control-plane

# Environment
EnvironmentFile=/opt/adproject/.env
Environment=NODE_ENV=production
Environment=SMTP_PORT=2525
Environment=INBOUND_EMAIL_WEBHOOK_URL=http://127.0.0.1:4001/api/autonomous/webhook/sendgrid

# Main process
ExecStart=/usr/bin/node dist/scripts/inbound-smtp.js

# Restart policy
Restart=always
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=inbound-smtp

[Install]
WantedBy=multi-user.target
