[Unit]
Description=Apex Mediation Control Plane
Documentation=https://github.com/apexmediation/ad-project
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/adproject/control-plane

# Environment
EnvironmentFile=/opt/adproject/control-plane.env
Environment=NODE_ENV=production

# Main process
ExecStart=/usr/bin/node dist/index.js

# Restart policy
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=control-plane

[Install]
WantedBy=multi-user.target
