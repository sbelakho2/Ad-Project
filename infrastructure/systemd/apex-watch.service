[Unit]
Description=Apex watch — daily app-ads.txt check, diff and alert
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=apex-watch
Group=apex
SupplementaryGroups=apex
# State lives in .apex/watch under the state root; the subscriber file the
# public sign-up writes is read from the same path.
WorkingDirectory=/var/lib/apex
EnvironmentFile=/etc/apex/watch.env
ExecStart=/usr/local/bin/apex-watch daily
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
# The watch owns the subscriber root and its notify state.
ReadWritePaths=/var/lib/apex/.apex/watch /var/lib/apex/.apex/notify
# Runner-owned and control-owned roots stay read-only.
ReadOnlyPaths=/var/lib/apex/.apex/ledgers /var/lib/apex/.apex/snapshots /var/lib/apex/.apex/proposals /var/lib/apex/.apex/priors /var/lib/apex/.apex/credentials /var/lib/apex/.apex/analytics-spool

# Hardening: no new privileges, no writable code or devices, and only the
# address families and system calls the services need.
UMask=0007
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
