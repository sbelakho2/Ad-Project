[Unit]
Description=Apex runner — refresh the account audit snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=apex
# WorkingDirectory anchors the default analytics spool under the state root;
# the expected fire time for lag telemetry rides APEX_SCHEDULED_AT_MS.
WorkingDirectory=/var/lib/apex
EnvironmentFile=/etc/apex/runner.env
# Runs before the cycle so the cycle proposes from a fresh snapshot.
ExecStart=/usr/local/bin/apex-runner audit
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/apex /var/lib/node_exporter/textfile
