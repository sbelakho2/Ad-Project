[Unit]
Description=Apex API
After=network-online.target
Wants=network-online.target

[Service]
User=apex
# The analytics spool and other relative defaults live under the state root.
WorkingDirectory=/var/lib/apex
EnvironmentFile=/etc/apex/api.env
ExecStart=/usr/local/bin/apex-api
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
# /var/lib/node_exporter/textfile is APEX_METRICS_TEXTFILE's directory.
ReadWritePaths=/var/lib/apex /var/lib/node_exporter/textfile

[Install]
WantedBy=multi-user.target
