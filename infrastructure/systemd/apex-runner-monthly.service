[Unit]
Description=Apex runner — monthly billing pass
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=apex
EnvironmentFile=/etc/apex/runner.env
# Bills the calendar month just closed (apex-runner computes it from the clock).
ExecStart=/usr/local/bin/apex-runner monthly
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/apex
