[Unit]
Description=Apex sales engine: import new free-audit leads, then send what is due
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=apex-sales
Group=apex
SupplementaryGroups=apex
# State lives in .apex/sales under the state root unless APEX_SALES_DIR moves it.
WorkingDirectory=/var/lib/apex
EnvironmentFile=/etc/apex/sales.env
# Free-audit requests from apex-api are imported first, so a publisher who
# asked for the audit is never cold-emailed. The import is idempotent; a
# missing leads file (no lead yet) does not stop the send pass.
ExecStart=/usr/local/bin/apex-sales import-leads ${APEX_SALES_LEADS_FILE}
ExecStart=/usr/local/bin/apex-sales run
# NoNewPrivileges blocks setgid queue helpers such as Postfix's postdrop, so
# APEX_SALES_SENDMAIL must name an unprivileged sendmail-compatible client
# (msmtp relaying to the authenticated outbound SMTP host).
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
# The engine owns the sales state directory (store, events, approvals and the
# outbox) only.
ReadWritePaths=/var/lib/apex/.apex/sales
# The synced lead imports and the watch store stay read-only.
ReadOnlyPaths=/var/lib/apex/.apex/imports /var/lib/apex/.apex/watch

# Hardening: no new privileges, no writable code or devices, and only the
# address families and system calls the services need.
UMask=0007
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
