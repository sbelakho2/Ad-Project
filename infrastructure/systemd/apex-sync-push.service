[Unit]
Description=Apex sync push (console host to object storage)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=apex-sync
Group=apex
SupplementaryGroups=apex
# WorkingDirectory anchors the default APEX_SYNC_* source paths under the
# state root. The run reads the ledger, invoice and leads files and writes
# only to the bucket; scratch goes to the private /tmp, so it needs no
# writable path under the state root.
WorkingDirectory=/var/lib/apex
EnvironmentFile=/etc/apex/sync.env
# The bucket credentials stay in a root-owned 0600 rclone.conf; systemd
# copies it into the unit's credential directory, which the service user
# can read (the scripts prefer CREDENTIALS_DIRECTORY/rclone.conf).
LoadCredential=rclone.conf:/etc/apex/rclone.conf
# rclone resolves its plugin cache through the passwd home (/nonexistent
# here); PrivateTmp gives the unit a writable /tmp for that cache.
Environment=XDG_CACHE_HOME=/tmp
ExecStart=/usr/local/bin/apex-sync-push
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
# The pushed sources stay read-only.
ReadOnlyPaths=/var/lib/apex/.apex/ledgers /var/lib/apex/.apex/billing -/var/lib/apex/.apex/leads.jsonl -/var/lib/apex/.apex/signin.jsonl

# Hardening: no new privileges, no writable code or devices, and only the
# address families and system calls the services need.
UMask=0007
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
