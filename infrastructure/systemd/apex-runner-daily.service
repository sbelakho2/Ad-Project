[Unit]
Description=Apex runner — daily measurement pass
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=apex
# WorkingDirectory anchors the default analytics spool under the state root;
# the expected fire time for lag telemetry rides APEX_SCHEDULED_AT_MS.
WorkingDirectory=/var/lib/apex
EnvironmentFile=/etc/apex/runner.env
ExecStart=/usr/local/bin/apex-runner daily
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/apex /var/lib/node_exporter/textfile
