[Unit]
Description=Apex control plane (operator console)
After=network-online.target
Wants=network-online.target

[Service]
User=apex
WorkingDirectory=/var/lib/apex
EnvironmentFile=/etc/apex/control.env
ExecStart=/usr/local/bin/apex-control
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
# /var/lib/node_exporter/textfile is APEX_METRICS_TEXTFILE's directory.
# .apex/analytics holds the control plane's analytics spool file.
ReadWritePaths=/var/lib/apex/.apex/control /var/lib/apex/.apex/analytics /var/lib/node_exporter/textfile

[Install]
WantedBy=multi-user.target
