# Apex sync environment file, installed as /etc/apex/sync.env on both hosts
# (root-owned, mode 0600). The push unit on the console host reads the
# APEX_SYNC_* source variables; the pull unit on the control host reads the
# APEX_CONTROL_* destinations and APEX_SYNC_IMPORTS_DIR. Install only the
# variables the host needs; see infrastructure/README.md, "Hosting split".
#
# No credentials live here. The bucket credentials stay in the rclone
# configuration file named by RCLONE_CONFIG (root-owned, mode 0600), and the
# scripts never place a secret on a command line.

# Object-storage bucket in rclone remote syntax: <remote>:<path>.
APEX_SYNC_REMOTE=object-store:apex-sync

# rclone configuration file holding the bucket credentials.
RCLONE_CONFIG=/etc/apex/rclone.conf

# Console host sources (apex-sync-push).
APEX_SYNC_LEDGER_ROOT=.apex/ledgers
APEX_SYNC_INVOICE_REGISTER=.apex/billing/invoices.jsonl
APEX_SYNC_LEADS_FILE=.apex/leads.jsonl

# Control-host destinations (apex-sync-pull). The defaults already resolve
# under the unit's WorkingDirectory=/var/lib/apex; name them explicitly only
# when a deployment moves them (they must stay under /var/lib/apex, which is
# the pull unit's writable path).
# APEX_CONTROL_LEDGER_ROOT=.apex/ledgers
# APEX_CONTROL_INVOICE_REGISTER=.apex/billing/invoices.jsonl
# APEX_SYNC_IMPORTS_DIR=.apex/imports
# APEX_CONTROL_SYNC_MARKER=.apex/control/sync-marker.json
