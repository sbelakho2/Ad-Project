# apex-ingest environment. The unit pins APEX_INGEST_CURSOR under the spool
# directory; override only with another writable path.
APEX_CLICKHOUSE_HTTP=http://127.0.0.1:8123
APEX_CLICKHOUSE_DB=apex
# APEX_CLICKHOUSE_USER=default
# APEX_CLICKHOUSE_PASSWORD=
# APEX_INGEST_CURSOR=.apex/analytics-spool/apex-access.cursor
