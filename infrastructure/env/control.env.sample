# apex-control environment. Copy to /etc/apex/control.env (0600).
APEX_CONTROL_BIND=127.0.0.1:8790
# Operator JSON: {"operators":[{"id":"...","password_hash":"<argon2>","totp_secret":"<base32>"}]}
# Create the hash with: apex-control hash-password
APEX_CONTROL_OPERATORS=/etc/apex/operators.json
# Replay protection for authenticator codes. The highest accepted time step
# per operator is loaded at startup and rewritten atomically (0600, temp +
# rename) on every code claim, so a restart cannot accept a spent code. An
# unreadable or malformed file fails closed (all codes refused until fixed).
APEX_CONTROL_TOTP_STATE=.apex/control/totp-steps.json
APEX_CONTROL_JOURNAL=.apex/control/journal.jsonl
APEX_CONTROL_POLICIES=.apex/control/policies.jsonl
APEX_CONTROL_INTERVENTIONS=.apex/control/interventions.jsonl
# The policy file the runner reads in preference to its inline policy. Keep
# this path identical to runner.env's APEX_EFFECTIVE_POLICY.
APEX_EFFECTIVE_POLICY=.apex/control/effective-policy.json
# The vault/connections root holding <publisher>.<plan>.json state files
# (managed plan activation writes here; the runner and console read it).
APEX_CONTROL_CONNECTIONS_ROOT=.apex/credentials
APEX_CONTROL_OPERATIONS=.apex/control/operations.json
APEX_CONTROL_LEDGER_ROOT=.apex/ledgers
# Verifying keys for the copied ledgers (publisher -> 64-hex key). Falls back
# to the shared APEX_LEDGER_KEYS when unset; unverified lines are never served.
# APEX_CONTROL_LEDGER_KEYS={"northstar":"<64 hex chars>"}
APEX_CONTROL_INVOICE_REGISTER=.apex/billing/invoices.jsonl
APEX_OPERATOR_JOBS_DIR=.apex/control/jobs
# Console-host service channel. The console host runs the runner and the
# policy page, so pause/resume and policy changes are delivered there over
# this authenticated endpoint. Configure both for split-host production.
# APEX_API_JOBS_URL=https://console.apexmediation.ee
# APEX_OPERATOR_JOBS_TOKEN=<same token as api.env>
# The control host's own audit copy of the effective policy.
APEX_EFFECTIVE_POLICY=.apex/effective-policy.json
# APEX_CLICKHOUSE_HTTP=http://127.0.0.1:8123
# APEX_CLICKHOUSE_DB=apex
APEX_ENVIRONMENT=production
