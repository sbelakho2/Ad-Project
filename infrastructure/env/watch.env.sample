# apex-watch environment (paid daily app-ads.txt watch and billing).
APEX_WATCH_ROOT=.apex/watch
APEX_CONSOLE_URL=https://console.apexmediation.ee
APEX_SUPPORT_URL=https://apexmediation.ee/support/
APEX_SITE_URL=https://apexmediation.ee
APEX_NOTIFY_SINK=email
APEX_NOTIFY_FROM=Apex <hello@apexmediation.ee>
# APEX_NOTIFY_SENDMAIL=/usr/sbin/sendmail
# APEX_NOTIFY_STATE=.apex/notify/delivery.jsonl
# APEX_WATCH_PAGE_URL=https://console.apexmediation.ee/watch
# Billing for paid watch:
# APEX_BILLING_PROFILE=/etc/apex/billing.json
# APEX_BILLING_VAT_RATE_BP=0
# APEX_MOLLIE_API_KEY=<key>
# APEX_MOLLIE_API_BASE=https://api.mollie.com
# APEX_MOLLIE_WEBHOOK_URL=https://console.example/v1/mollie/webhook
# APEX_MOLLIE_REDIRECT_URL=https://console.example/watch/requested
