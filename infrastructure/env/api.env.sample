# apex-api environment. Copy to /etc/apex/api.env (0600, owner apex) and fill.
# Required for a working self-serve console:
APEX_API_BIND=127.0.0.1:8787
APEX_SNAPSHOT_ROOT=.apex/snapshots
APEX_LEDGER_ROOT=.apex/ledgers
# JSON object: {"publisher": "<32+ byte bearer token>"}. Without it every
# ledger read answers 404.
APEX_LEDGER_KEYS={"northstar":"replace-with-a-32-byte-random-token"}
APEX_LEDGER_TOKENS_FILE=.apex/ledger-tokens.json
APEX_LEADS_FILE=.apex/leads.jsonl
# Bearer token for POST /v1/leads. Without it, the endpoint derives the
# publisher from the lead's email domain so an anonymous caller cannot
# attribute a lead to another workspace.
# APEX_LEADS_TOKEN=<32+ byte random token>
APEX_SIGNIN_TTL_HOURS=24
# Absolute console origin the emailed one-time links point at. Unset disables
# sign-in links (free-audit still records the lead).
APEX_CONSOLE_URL=https://console.apexmediation.ee
# Absolute help target used by authenticated console pages.
APEX_SUPPORT_URL=https://apexmediation.ee/support/
# Marketing origin used by the marketing-shell pages apex-api renders
# (free-audit, watch, confirmation). Defaults to the public site.
APEX_SITE_URL=https://apexmediation.ee
# Provisioned workspace domains: {"publisher-key":"domain.example"}. A
# token-only workspace that already holds runner data can be claimed only by
# an address on its declared domain. Omit for new, empty workspaces.
# APEX_WORKSPACE_DOMAINS={"northstar":"northstar.example"}
# Proposal review store the runner writes and the console reads.
APEX_PROPOSALS_ROOT=.apex/proposals
# Governance delivered by the control plane to this console host.
APEX_CONTROL_INTERVENTIONS=.apex/control/interventions.jsonl
APEX_EFFECTIVE_POLICY=.apex/effective-policy.json
# Bearer token the control plane presents on the operator-jobs and governance
# channels. Required for split-host governance.
# APEX_OPERATOR_JOBS_TOKEN=<32+ byte random token>
# Split-host operator job directory.
# APEX_OPERATOR_JOBS_DIR=.apex/control/jobs
# The control plane's effective policy wins when set; APEX_POLICY_FILE is the
# legacy fallback.
# APEX_EFFECTIVE_POLICY=.apex/control/effective-policy.json
APEX_POLICY_FILE=.apex/policy.json
APEX_ALERT_FILE=.apex/alerts.jsonl
# Sign-in and notification email: without a sink, links are not delivered.
APEX_NOTIFY_SINK=email
APEX_NOTIFY_FROM=Apex <hello@apexmediation.ee>
# APEX_NOTIFY_SENDMAIL=/usr/sbin/sendmail
APEX_NOTIFY_STATE=.apex/notify/delivery.jsonl
# Publisher-scoped settings shown in the console.
APEX_CONSOLE_PUBLISHER_NAME=Northstar Studio
APEX_CONSOLE_CURRENCY=USD
# APEX_CONSOLE_CONTACT=billing@example.com
# APEX_CONSOLE_TIMEZONE=UTC
# APEX_RETENTION_MONTHS=18
# Adyen webhook and collection (billing is 503 without the HMAC key):
# APEX_ADYEN_HMAC_KEY=<hex>
# APEX_COLLECTION_FILE=.apex/billing/collection.jsonl
# APEX_ADYEN_API_KEY=<key>
# APEX_ADYEN_MERCHANT_ACCOUNT=<merchant>
# APEX_ADYEN_CHECKOUT_BASE=https://checkout.adyen.com
# Secret/credential roots:
# APEX_VAULT_KEY_HEX=<64 hex chars>
# APEX_CREDENTIAL_ROOT=.apex/credentials
# APEX_LIVE_AUDIT_TOKEN=<token>
# Analytics read model:
# APEX_CLICKHOUSE_HTTP=http://127.0.0.1:8123
# APEX_CLICKHOUSE_DB=apex
# APEX_ANALYTICS_SPOOL=.apex/analytics-spool
# Adapter bases for connection validation:
# APEX_LEVELPLAY_BASE=https://api.levelplay.com
# APEX_ADMOB_BASE=https://admob.googleapis.com
# APEX_MAIL_WEBHOOK=https://hooks.example.com/leads
# APEX_LEAD_ID_SALT=change-me
# APEX_OPERATOR_JOBS_DIR=.apex/control/jobs
