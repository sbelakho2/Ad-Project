# apex-sales environment. Owner-only outbound engine; never exposed.
APEX_SALES_DIR=.apex/sales
APEX_SALES_MODE=shadow
APEX_SALES_FROM=Apex <founder@apexmediation.ee>
APEX_SALES_FROM_NAME=Apex
APEX_SALES_COMPANY=Apex
APEX_SALES_ADDRESS=<postal address>
APEX_SALES_DAILY_MAX=20
APEX_SALES_SENDMAIL=/usr/sbin/sendmail
# APEX_SALES_OUTBOX=.apex/sales/outbox
# APEX_SALES_SENDERS_FILE=.apex/sales/senders.json
# The control host receives the console host's outcomes under imports/: the
# sync-pull unit can write only its own import directory, not .apex/sales.
APEX_SALES_OUTCOMES_FILE=.apex/imports/outcomes.jsonl
# The control host receives the console host's leads under imports/.
APEX_SALES_LEADS_FILE=.apex/imports/leads.jsonl
# APEX_SALES_HOLDOUT=0.1
# APEX_SALES_HOLDOUT_SALT=<random>
# APEX_SALES_TOKEN_SALT=<random>
# APEX_SALES_UNSUBSCRIBE_URL=https://apexmediation.ee/unsubscribe/
# APEX_SALES_FETCH_DELAY_MS=1000
