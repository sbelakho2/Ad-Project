# apex-runner environment (audit, cycle, daily and monthly passes).
APEX_RUNNER_DATA_DIR=.apex/runner
APEX_RUNNER_LEDGER_ROOT=.apex/ledgers
APEX_SNAPSHOT_ROOT=.apex/snapshots
# Where held proposals are published for console review and where recorded
# approvals are read from. Required for the approval gate to resolve.
APEX_PROPOSALS_ROOT=.apex/proposals
# Governance the control plane delivers to this host (pause register and the
# effective policy). The console host receives them over the authenticated
# APEX_OPERATOR_JOBS_TOKEN channel; the defaults below are the runner's
# defaults and are read even when these variables are unset.
APEX_CONTROL_INTERVENTIONS=.apex/control/interventions.jsonl
APEX_EFFECTIVE_POLICY=.apex/effective-policy.json
APEX_RUNNER_LEDGER=.apex/ledgers/northstar.jsonl
# Ledger signature verification threads (optional tuning; defaults to the
# verifier's own bound).
# APEX_LEDGER_VERIFY_THREADS=4
# The control plane's effective policy file wins over the inline policy when
# set. Keep this path identical to control.env's APEX_EFFECTIVE_POLICY.
# APEX_EFFECTIVE_POLICY=.apex/control/effective-policy.json
APEX_RUNNER_POLICY=policy.json
APEX_RUNNER_PRIORS=.apex/priors
# Fleet pause/resume interventions written by apex-control. When the latest
# applicable record is a pause, the cycle skips that platform's writes; reads
# and measurement continue. Default: .apex/control/interventions.jsonl.
APEX_CONTROL_INTERVENTIONS=.apex/control/interventions.jsonl
APEX_CONNECTIONS_ROOT=.apex/credentials
APEX_VAULT_KEY_HEX=<64 hex chars>
APEX_CONSOLE_URL=https://console.apexmediation.ee
# Platform credentials:
# APEX_MAX_API_KEY=<key>
# APEX_MAX_MANAGEMENT_BASE=https://api.applovin.com
# APEX_MAX_REPORTING_BASE=https://r.applovin.com
# APEX_MAX_REPORT_KEY=<report key>
# LevelPlay/AdMob adapter bases and vault entries follow the same APEX_* names
# documented in infrastructure/README.md.
# Analytics and events:
# APEX_CLICKHOUSE_HTTP=http://127.0.0.1:8123
# APEX_CLICKHOUSE_DB=apex
# APEX_ANALYTICS_SPOOL=.apex/analytics-spool
# Notifications and billing:
# APEX_NOTIFY_SINK=email
# APEX_NOTIFY_FROM=Apex <hello@apexmediation.ee>
# APEX_BILLING_PROFILE=/etc/apex/billing.json
APEX_BILLING_VAT_RATE_BP=0
# APEX_MONITORING_FEE_MICROS / APEX_MONITORING_TIER_*_MICROS override the tier table.
# Payment collection:
# APEX_PAYMENT_EVENTS=.apex/billing/collection.jsonl
# APEX_PAYMENT_CURSOR=.apex/billing/collection.cursor
# APEX_PAYMENT_LEDGER=.apex/billing/payments.jsonl
# APEX_PAYMENT_RETRIES=.apex/billing/retries.jsonl
# APEX_MOLLIE_API_KEY=<key>
# APEX_MOLLIE_API_BASE=https://api.mollie.com
# APEX_MOLLIE_WEBHOOK_URL=https://console.example/v1/mollie/webhook
# APEX_MOLLIE_REDIRECT_URL=https://console.example/watch/requested
