{
  # Global options
  # Set these env vars on the host/systemd unit:
  # - CADDY_EMAIL=hello@apexmediation.ee
  email {env.CADDY_EMAIL}

  # Prefer modern defaults
  servers {
    protocols h1 h2
  }
}

# -----------------------------------------------------------------------------
# Control Plane (operator-only) - COMPLETELY SEPARATE from customer console
# This is the internal operator admin panel, NOT customer-facing
# Access: admin.apexmediation.ee → Control Plane service on port 4000
# -----------------------------------------------------------------------------
admin.apexmediation.ee {
  reverse_proxy localhost:4000
}

# -----------------------------------------------------------------------------
# Customer API
# -----------------------------------------------------------------------------
api.apexmediation.ee {
  reverse_proxy localhost:8080
}

# -----------------------------------------------------------------------------
# Customer Console - Customer-facing dashboard
# Access: console.apexmediation.ee → Console service on port 3000
# -----------------------------------------------------------------------------
console.apexmediation.ee {
  reverse_proxy localhost:3000
}

# -----------------------------------------------------------------------------
# Marketing Website
# -----------------------------------------------------------------------------
apexmediation.ee, www.apexmediation.ee {
  # Next.js standalone served by PM2 on the app server
  reverse_proxy 127.0.0.1:3002
}
