# Edge for the current product. Set APEX_DOMAIN and SITE_DOMAIN in the
# environment; the defaults are placeholders for local validation only.
{$APEX_DOMAIN:apex.example} {
	encode gzip
	reverse_proxy 127.0.0.1:8787
}

{$SITE_DOMAIN:www.apex.example} {
	encode gzip
	root * /srv/site/public
	file_server
}
