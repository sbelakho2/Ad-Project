# Edge for the current product. Set APEX_DOMAIN (API host), SITE_DOMAIN
# (marketing host) and CONSOLE_DOMAIN (console host) in the environment; the
# defaults are placeholders for local validation only. The operator plane is
# not on this edge: apex-control runs on the control host and binds loopback
# there (infrastructure/README.md, "Hosting split").
#
# The API never serves a publisher's ledger unauthenticated: `/v1/ledger/*`
# and `/console/ledger` require that publisher's bearer token, and the routes
# answer 503 when no token is configured. The edge only reverse-proxies the
# loopback-bound service, so nothing is reachable without a token.
#
# `/metrics` is operator-only: apex-api serves it on its loopback bind (the
# control/localhost boundary scrapes it there) and the public API and console
# hosts below refuse the path, so process internals are never published on
# the edge.
#
# Three public hosts plus the internal control host:
# - the marketing host serves the static Zola site for GET pages, and proxies
#   only three path families to apex-api: POST /free-audit (the request form),
#   /audit-requested/* (the confirmation pages, which are apex-api HTML and
#   load the design-system fonts from /assets/fonts/*) and /assets/fonts/*
#   (the self-hosted WOFF2 faces for those pages). Everything else, including
#   GET /free-audit and every /console path, stays static: the marketing host
#   no longer serves /console.
# - the API host proxies its whole origin to apex-api.
# - the console host proxies its whole origin to apex-api, so `/` is the
#   console overview, `/console/*` the console pages, `/assets/*` the fonts
#   and styles, and `/favicon*`, `/watch*` and POST /free-audit reach the
#   service. Set APEX_CONSOLE_URL to https://console.<domain> so emailed
#   sign-in links land on the console origin.
# - the internal control host runs apex-control on loopback and has no block
#   here.

{$SITE_DOMAIN:www.apexmediation.ee} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'none'; object-src 'none'"
	}

	# The marketing JSON access log `apex-ingest` reads: the parser keeps the
	# route template, status, referrer host, allow-listed query keys and the
	# campaign code only, never a query value. The raw file keeps the standard
	# Caddy fields it must read (uri with query string, headers); at-rest
	# handling is documented in infrastructure/README.md.
	log {
		output file {$APEX_ACCESS_LOG:/var/log/caddy/apex-access.json}
		format json
	}

	# The free-audit request form POSTs to apex-api; GET /free-audit (form or
	# trailing slash) stays on the static site.
	@audit_submission {
		method POST
		path /free-audit
	}
	reverse_proxy @audit_submission 127.0.0.1:8787

	# The confirmation pages after a stored audit request.
	@audit_requested path /audit-requested/*
	reverse_proxy @audit_requested 127.0.0.1:8787

	# The design-system assets those HTML pages load: the shared stylesheet
	# and its fonts. The site's own faces live under /fonts/* and stay
	# static; /assets/* only exists on apex-api.
	@site_assets path /assets/fonts/* /assets/apex.css
	reverse_proxy @site_assets 127.0.0.1:8787

	root * /srv/site/public
	file_server
}

{$APEX_DOMAIN:api.apexmediation.ee} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'none'; object-src 'none'"
	}

	# Metrics stay on the loopback/control boundary: refuse the public path
	# before the catch-all proxy rather than publishing process internals.
	@metrics path /metrics
	respond @metrics 404

	reverse_proxy 127.0.0.1:8787
}

{$CONSOLE_DOMAIN:console.apexmediation.ee} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'none'; object-src 'none'"
	}

	# The console overview is `/` of this origin; everything under it, from
	# `/console/*` pages to `/assets/*`, `/favicon*`, `/watch*` and the
	# POST /free-audit form, belongs to apex-api. Metrics stay operator-only.
	@metrics path /metrics
	respond @metrics 404

	reverse_proxy 127.0.0.1:8787
}
