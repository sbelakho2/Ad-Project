+            id: "x",
+            step: 0,
+            subject: "{app",
+            body: "",
+        };
+        assert!(render(&unclosed, &publisher(), &contact(), &sender()).is_err());
+        let filler = Template {
+            id: "x",
+            step: 0,
+            subject: "Quick question about {app}",
+            body: "",
+        };
+        assert_eq!(
+            render(&filler, &publisher(), &contact(), &sender()),
+            Err(ComposeError::Banned("quick question"))
