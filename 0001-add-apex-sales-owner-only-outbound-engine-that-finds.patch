+        assert!(m.raw.contains("Message-ID: <t-abc@apexmediation.ee>\r\n"));
+        assert!(m.raw.contains("List-Unsubscribe: <https://apexmediation.ee/u/tok123>, <mailto:aaron@apexmediation.ee?subject=unsubscribe>\r\n"));
+        assert!(m
+            .raw
