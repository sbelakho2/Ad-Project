+[Unit]
+Description=Apex sales engine: import new free-audit leads, then send what is due
+After=network-online.target
+Wants=network-online.target
+
+[Service]
+Type=oneshot
+User=apex
+# State lives in .apex/sales under the state root unless APEX_SALES_DIR moves it.
+WorkingDirectory=/var/lib/apex
