+        assert!(m.raw.contains("Tallinn, Estonia"));
+        assert!(!m.raw.replace("\r\n", "").contains('\n'), "CRLF only");
+        assert!(m.raw.split("\r\n").all(|l| l.chars().count() <= 200));
+        assert_eq!(m.message_id, "t-abc@apexmediation.ee");
