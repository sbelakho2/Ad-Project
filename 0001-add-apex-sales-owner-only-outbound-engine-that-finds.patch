index 00000000..b2f3e75c
--- /dev/null
+++ b/rust/crates/apex-sales/src/cadence.rs
@@ -0,0 +1,223 @@
+//! When to send, and when to stop following up.
+//!
+//! # Send time
+//!
+//! Each local business hour (8:00 to 18:00, Monday to Friday) has a Beta
+//! posterior over the interest rate of sends made then, partially pooled
+//! toward the all-hours rate with strength [`SendTimeModel::pooling`]. The
+//! slot is chosen by Thompson sampling, so hours with little data are still
+//! explored and hours that clearly underperform stop being used.
+//!
+//! # Follow-ups: an optimal-stopping rule
+//!
+//! For step *k* of a sequence, `h_k` is the probability of an interested
+//! reply to that touch given no reply so far (a discrete-time hazard) and
+//! `c_k` the probability of a spam complaint. Both are Beta posteriors per
+//! step. The next touch is sent only if its expected value is positive:
+//!
+//! ```text
+//! E[h_k] · V_interest − cost_per_touch − E[c_k] · C_complaint > 0
+//! ```
+//!
+//! where `V_interest` comes from [`crate::funnel`] for the publisher's band.
+//! Hazards decline with each touch, so the rule stops sequences early for
+//! low-value publishers and lets high-value ones run to the hard cap.
+
+use crate::rng::Rng;
+
+/// First and last local sending hour (inclusive).
+pub const HOURS: std::ops::RangeInclusive<u32> = 8..=18;
+
+/// Send-time model over local business hours.
+#[derive(Debug, Clone, PartialEq)]
+pub struct SendTimeModel {
+    /// `(interested, sends)` per hour, index `hour − 8`.
+    pub counts: [(f64, f64); 11],
+    /// Prior for the all-hours rate `(alpha, beta)`.
+    pub prior: (f64, f64),
+    /// Pooling strength toward the all-hours rate.
+    pub pooling: f64,
+    /// Hour used when nothing has been learned yet.
+    pub default_hour: u32,
+}
+
+impl Default for SendTimeModel {
+    fn default() -> Self {
+        Self {
+            counts: [(0.0, 0.0); 11],
+            prior: (1.0, 99.0),
+            pooling: 200.0,
+            default_hour: 10,
+        }
+    }
+}
+
+impl SendTimeModel {
+    /// Record a settled send at local `hour`.
+    pub fn observe(&mut self, hour: u32, interested: bool) {
+        if let Some(c) = self
+            .counts
+            .get_mut(usize::try_from(hour.saturating_sub(8)).unwrap_or(usize::MAX))
+            .filter(|_| HOURS.contains(&hour))
+        {
+            c.1 += 1.0;
+            if interested {
+                c.0 += 1.0;
+            }
+        }
+    }
+
+    fn pooled_rate(&self) -> f64 {
+        let (k, n) = self
+            .counts
+            .iter()
+            .fold((0.0, 0.0), |(k, n), (a, b)| (k + a, n + b));
+        (self.prior.0 + k) / (self.prior.0 + self.prior.1 + n)
+    }
+
+    /// Posterior `(alpha, beta)` for an hour slot index.
+    pub fn slot_posterior(&self, slot: usize) -> (f64, f64) {
+        let mu = self.pooled_rate();
+        let (k, n) = self.counts.get(slot).copied().unwrap_or((0.0, 0.0));
+        (self.pooling * mu + k, self.pooling * (1.0 - mu) + n - k)
+    }
+
+    /// Choose a local hour by Thompson sampling; the default hour while no
+    /// send has been observed.
+    pub fn choose_hour(&self, rng: &mut Rng) -> u32 {
+        let total: f64 = self.counts.iter().map(|c| c.1).sum();
+        if total == 0.0 {
+            return self.default_hour;
+        }
+        let mut best = self.default_hour;
+        let mut best_v = f64::NEG_INFINITY;
+        for (slot, hour) in HOURS.enumerate() {
+            let (a, b) = self.slot_posterior(slot);
+            let v = rng.beta(a, b);
+            if v > best_v {
+                best_v = v;
+                best = hour;
+            }
+        }
+        best
+    }
+}
+
+/// Per-step reply and complaint hazards.
+#[derive(Debug, Clone, PartialEq)]
+pub struct StepModel {
+    /// Interest hazard posterior `(alpha, beta)` per step (index 0 = first
+    /// touch).
+    pub interest: Vec<(f64, f64)>,
+    /// Complaint posterior per step.
+    pub complaint: Vec<(f64, f64)>,
+}
+
+impl StepModel {
+    /// Documented priors for `steps` touches: interest hazards of 1.2%,
+    /// 0.6%, 0.4% and 0.3% (each worth 300 sends), complaints of 0.05%.
+    pub fn with_steps(steps: usize) -> Self {
+        let base = [0.012, 0.006, 0.004, 0.003];
+        let interest = (0..steps)
+            .map(|k| {
+                let h = base.get(k).copied().unwrap_or(0.002);
+                (h * 300.0, (1.0 - h) * 300.0)
+            })
+            .collect();
+        let complaint = (0..steps).map(|_| (1.0, 1999.0)).collect();
+        Self {
+            interest,
+            complaint,
+        }
+    }
+
+    /// Record a settled touch at step `k`.
+    pub fn observe(&mut self, k: usize, interested: bool, complaint: bool) {
+        if let Some(p) = self.interest.get_mut(k) {
+            if interested {
+                p.0 += 1.0;
+            } else {
+                p.1 += 1.0;
+            }
+        }
+        if let Some(c) = self.complaint.get_mut(k) {
+            if complaint {
+                c.0 += 1.0;
+            } else {
+                c.1 += 1.0;
+            }
+        }
+    }
+
+    /// Expected value of sending touch `k`. `None` past the last step.
+    pub fn touch_value(
+        &self,
+        k: usize,
+        value_interest: f64,
+        cost: f64,
+        complaint_cost: f64,
+    ) -> Option<f64> {
+        let (a, b) = *self.interest.get(k)?;
+        let (ca, cb) = *self.complaint.get(k)?;
+        Some(a / (a + b) * value_interest - cost - ca / (ca + cb) * complaint_cost)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn send_time_learns_the_best_hour() {
+        let mut m = SendTimeModel::default();
+        let mut rng = Rng::seeded(6);
+        assert_eq!(m.choose_hour(&mut rng), 10);
+        for hour in HOURS {
+            let rate = if hour == 15 { 0.04 } else { 0.01 };
+            for i in 0..3000 {
+                m.observe(hour, (i as f64) < rate * 3000.0);
+            }
+        }
+        m.observe(22, true);
+        m.observe(3, true);
+        let mut picks = 0;
+        for _ in 0..500 {
+            if m.choose_hour(&mut rng) == 15 {
+                picks += 1;
+            }
+        }
+        assert!(picks > 450, "{picks}");
+        let (a, b) = m.slot_posterior(99);
+        assert!(a > 0.0 && b > 0.0);
+    }
+
+    #[test]
+    fn stopping_rule_depends_on_lead_value() {
+        let m = StepModel::with_steps(5);
+        let cost = 0.5;
+        let complaint_cost = 200.0;
+        // A $720 interested reply (core band) justifies every touch...
+        for k in 0..4 {
+            assert!(
+                m.touch_value(k, 720.0, cost, complaint_cost).unwrap() > 0.0,
+                "{k}"
+            );
+        }
+        // ...a $144 one (small band) stops after the second touch.
+        assert!(m.touch_value(0, 144.0, cost, complaint_cost).unwrap() > 0.0);
+        assert!(m.touch_value(3, 144.0, cost, complaint_cost).unwrap() < 0.0);
+        assert!(m.touch_value(5, 720.0, cost, complaint_cost).is_none());
+    }
+
+    #[test]
+    fn complaints_on_a_step_shut_it_down() {
+        let mut m = StepModel::with_steps(3);
+        let before = m.touch_value(2, 720.0, 0.5, 200.0).unwrap();
+        for i in 0..500 {
+            m.observe(2, false, i % 20 == 0);
+        }
+        let after = m.touch_value(2, 720.0, 0.5, 200.0).unwrap();
+        assert!(before > 0.0 && after < 0.0, "{before} {after}");
+        m.observe(9, true, true);
+    }
+}
diff --git a/rust/crates/apex-sales/src/calendar.rs b/rust/crates/apex-sales/src/calendar.rs
new file mode 100644
index 00000000..53f320d6
--- /dev/null
+++ b/rust/crates/apex-sales/src/calendar.rs
@@ -0,0 +1,197 @@
+//! Calendar arithmetic on Unix seconds, without a time-zone database.
+//!
+//! Civil-date conversion uses Howard Hinnant's `days_from_civil` and
+//! `civil_from_days` algorithms (proleptic Gregorian, exact for all `i64`
+//! day counts in range). Local time is a fixed UTC offset in minutes; the
+//! engine schedules to the hour, so daylight-saving error is at most one
+//! hour and is documented where offsets are chosen.
+
+use crate::model::{UnixSecs, DAY};
+
+/// Days since 1970-01-01 for a proleptic Gregorian date.
+pub fn days_from_civil(y: i64, m: i64, d: i64) -> i64 {
+    let y = if m <= 2 { y - 1 } else { y };
+    let era = if y >= 0 { y } else { y - 399 } / 400;
+    let yoe = y - era * 400;
+    let mp = (m + 9) % 12;
+    let doy = (153 * mp + 2) / 5 + d - 1;
+    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+    era * 146_097 + doe - 719_468
+}
+
+/// `(year, month, day)` for a day count since 1970-01-01.
+pub fn civil_from_days(z: i64) -> (i64, i64, i64) {
+    let z = z + 719_468;
+    let era = if z >= 0 { z } else { z - 146_096 } / 146_097;
+    let doe = z - era * 146_097;
+    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;
+    let y = yoe + era * 400;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = doy - (153 * mp + 2) / 5 + 1;
+    let m = if mp < 10 { mp + 3 } else { mp - 9 };
+    (if m <= 2 { y + 1 } else { y }, m, d)
+}
+
+/// Day of week for a day count, 0 = Sunday ... 6 = Saturday.
+pub fn weekday(days: i64) -> i64 {
+    (days + 4).rem_euclid(7)
+}
+
+/// Local `(days since epoch, hour, weekday)` at `t` for a UTC offset.
+pub fn local_parts(t: UnixSecs, offset_minutes: i32) -> (i64, i64, i64) {
+    let local = t + i64::from(offset_minutes) * 60;
+    let days = local.div_euclid(DAY);
+    let hour = local.rem_euclid(DAY) / 3600;
+    (days, hour, weekday(days))
+}
+
+/// The earliest instant at or after `after` that falls at the start of local
+/// `hour` on a weekday (Monday to Friday), for the given UTC offset.
+pub fn next_weekday_hour(after: UnixSecs, offset_minutes: i32, hour: u32) -> UnixSecs {
+    let hour = i64::from(hour.min(23));
+    let offset = i64::from(offset_minutes) * 60;
+    let local_after = after + offset;
+    let start = local_after.div_euclid(DAY);
+    for day in start..start + 8 {
+        let candidate = day * DAY + hour * 3600;
+        if candidate >= local_after && (1..=5).contains(&weekday(day)) {
+            return candidate - offset;
+        }
+    }
+    after
+}
+
+/// RFC 5322 `Date:` value in UTC, e.g. `Fri, 16 Oct 2026 10:13:00 +0000`.
+pub fn rfc5322_date(t: UnixSecs) -> String {
+    const DAYS: [&str; 7] = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
+    const MONTHS: [&str; 12] = [
+        "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec",
+    ];
+    let days = t.div_euclid(DAY);
+    let secs = t.rem_euclid(DAY);
+    let (y, m, d) = civil_from_days(days);
+    let wd = DAYS.get(weekday(days) as usize).copied().unwrap_or("Mon");
+    let mon = MONTHS.get((m - 1) as usize).copied().unwrap_or("Jan");
+    format!(
+        "{wd}, {d:02} {mon} {y} {:02}:{:02}:{:02} +0000",
+        secs / 3600,
+        (secs % 3600) / 60,
+        secs % 60
+    )
+}
+
+/// `YYYY-MM-DD` of `t` in UTC.
+pub fn ymd(t: UnixSecs) -> String {
+    let (y, m, d) = civil_from_days(t.div_euclid(DAY));
+    format!("{y:04}-{m:02}-{d:02}")
+}
+
+/// Typical standard-time UTC offset in minutes for a country (ISO alpha-2).
+/// Countries spanning zones use their main business hub. Unknown countries
+/// return `None`; callers fall back to UTC.
+pub fn country_offset_minutes(country: &str) -> Option<i32> {
+    const TABLE: [(&str, i32); 44] = [
+        ("US", -300),
+        ("CA", -300),
+        ("MX", -360),
+        ("BR", -180),
+        ("AR", -180),
+        ("CL", -240),
+        ("CO", -300),
+        ("GB", 0),
+        ("IE", 0),
+        ("PT", 0),
+        ("ES", 60),
+        ("FR", 60),
+        ("DE", 60),
+        ("NL", 60),
+        ("BE", 60),
+        ("IT", 60),
+        ("PL", 60),
+        ("SE", 60),
+        ("DK", 60),
+        ("NO", 60),
+        ("CH", 60),
+        ("AT", 60),
+        ("CZ", 60),
+        ("FI", 120),
+        ("EE", 120),
+        ("LT", 120),
+        ("LV", 120),
+        ("UA", 120),
+        ("RO", 120),
+        ("GR", 120),
+        ("IL", 120),
+        ("CY", 120),
+        ("TR", 180),
+        ("RU", 180),
+        ("BY", 180),
+        ("AE", 240),
+        ("IN", 330),
+        ("VN", 420),
+        ("TH", 420),
+        ("ID", 420),
+        ("CN", 480),
+        ("SG", 480),
+        ("KR", 540),
+        ("JP", 540),
+    ];
+    let c = country.trim().to_ascii_uppercase();
+    TABLE.iter().find(|(k, _)| *k == c).map(|(_, v)| *v)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn civil_round_trips_across_eras() {
+        for (y, m, d) in [
+            (1970, 1, 1),
+            (2000, 2, 29),
+            (1969, 12, 31),
+            (2026, 10, 16),
+            (1600, 3, 1),
+        ] {
+            let z = days_from_civil(y, m, d);
+            assert_eq!(civil_from_days(z), (y, m, d));
+        }
+        assert_eq!(days_from_civil(1970, 1, 1), 0);
+        assert_eq!(days_from_civil(2026, 10, 16), 20_742);
+        assert_eq!(weekday(0), 4);
+        assert_eq!(weekday(20_742), 5);
+        assert_eq!(weekday(-1), 3);
+    }
+
+    #[test]
+    fn formats_dates() {
+        assert_eq!(rfc5322_date(0), "Thu, 01 Jan 1970 00:00:00 +0000");
+        let t = 20_742 * DAY + 10 * 3600 + 13 * 60;
+        assert_eq!(rfc5322_date(t), "Fri, 16 Oct 2026 10:13:00 +0000");
+        assert_eq!(ymd(t), "2026-10-16");
+    }
+
+    #[test]
+    fn schedules_the_next_weekday_hour_in_local_time() {
+        // Friday 16 Oct 2026 10:13 UTC; Berlin is +60 in this table.
+        let now = 20_742 * DAY + 10 * 3600 + 13 * 60;
+        let t = next_weekday_hour(now, 60, 14);
+        assert_eq!(t, 20_742 * DAY + 13 * 3600);
+        // 09:00 local has passed today, so the next is Monday 19 Oct.
+        let t = next_weekday_hour(now, 60, 9);
+        assert_eq!(t, 20_745 * DAY + 8 * 3600);
+        assert_eq!(local_parts(t, 60), (20_745, 9, 1));
+        // A negative offset that crosses midnight.
+        let t = next_weekday_hour(now, -300, 9);
+        assert_eq!(local_parts(t, -300).1, 9);
+        assert!(t >= now);
+    }
+
+    #[test]
+    fn country_offsets() {
+        assert_eq!(country_offset_minutes("de"), Some(60));
+        assert_eq!(country_offset_minutes("IN"), Some(330));
+        assert_eq!(country_offset_minutes("ZZ"), None);
+    }
+}
