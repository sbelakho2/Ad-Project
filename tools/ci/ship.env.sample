# tools/ci/ship.env.sample: copy to tools/ci/ship.env and adjust.
# Nothing in this file is a secret: the ssh transport uses your ssh config
# and agent, and no key path or password is ever passed on a command line.

APEX_SHIP_HOST=deploy@apex-deploy-1
APEX_SHIP_BIN_DIR=/usr/local/bin

# Units restarted after the binaries land. Unset means the per-service map:
# apex-api.service, apex-control.service, apex-sales-web.service,
# apex-watch.service, apex-ingest.service, and the four apex-runner
# services (audit, cycle, daily, monthly) for apex-runner.
# APEX_SHIP_UNITS="apex-api.service apex-control.service"

# Cross target for the deploy platform. Set it when shipping from a Mac:
# release artifacts must be Linux builds even though the checkout is not.
# APEX_SHIP_TARGET=x86_64-unknown-linux-gnu

# Local artifact dir override; defaults to rust/target/release or
# rust/target/<APEX_SHIP_TARGET>/release.
# APEX_SHIP_ARTIFACT_DIR=
