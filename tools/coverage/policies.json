{
  "__comment": "Policy tables for the coverage classifier (all-Rust platform plus the SDK ecosystem). DOMAINS: first-match-wins include/exclude patterns per domain. EXCLUSIONS: reason-coded file patterns checked before domains. Validated against the live tree by apex-tools manifest.",
  "domains": [
    {
      "id": "meta-test",
      "kind": "test",
      "include": [
        "**/*.test.ts",
        "**/*_test.go",
        "**/__tests__/**",
        "**/tests/**",
        "**/Tests/**",
        "**/src/test/**",
        "**/*.bats",
        "**/__mocks__/**",
        "**/docs/**/*.tsx",
        "**/fixtures/**",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/src/androidTest/**",
        "sdk/flutter/test/**",
        "**/setupTests.ts"
      ]
    },
    {
      "id": "apex-core",
      "kind": "code",
      "include": [
        "rust/crates/apex-core/**/*.rs"
      ]
    },
    {
      "id": "apex-connectors",
      "kind": "code",
      "include": [
        "rust/crates/apex-connectors/**/*.rs"
      ]
    },
    {
      "id": "apex-audit",
      "kind": "code",
      "include": [
        "rust/crates/apex-audit/**/*.rs"
      ]
    },
    {
      "id": "apex-autopilot",
      "kind": "code",
      "include": [
        "rust/crates/apex-autopilot/**/*.rs"
      ]
    },
    {
      "id": "apex-proof",
      "kind": "code",
      "include": [
        "rust/crates/apex-proof/**/*.rs"
      ]
    },
    {
      "id": "apex-billing",
      "kind": "code",
      "include": [
        "rust/crates/apex-billing/**/*.rs"
      ]
    },
    {
      "id": "apex-api",
      "kind": "code",
      "include": [
        "rust/crates/apex-api/**/*.rs"
      ]
    },
    {
      "id": "apex-tools",
      "kind": "code",
      "include": [
        "rust/crates/apex-tools/**/*.rs"
      ]
    },
    {
      "id": "mail-server",
      "kind": "code",
      "include": [
        "services/mail-server/**/*.rs"
      ]
    },
    {
      "id": "android-core",
      "kind": "code",
      "include": [
        "sdk/core/android/src/main/**/*.kt",
        "sdk/core/android/strictmode-sample/src/main/**/*.kt"
      ]
    },
    {
      "id": "android-ctv",
      "kind": "code",
      "include": [
        "sdk/ctv/android-tv/src/main/**/*.kt"
      ]
    },
    {
      "id": "ios-swift",
      "kind": "code",
      "include": [
        "sdk/core/ios/Sources/**/*.swift",
        "sdk/adapter-dev-kit/ios/Sources/**/*.swift"
      ]
    },
    {
      "id": "tvos-swift",
      "kind": "code",
      "include": [
        "sdk/ctv/tvos/Sources/**/*.swift"
      ]
    },
    {
      "id": "flutter",
      "kind": "code",
      "include": [
        "sdk/flutter/lib/**/*.dart"
      ]
    },
    {
      "id": "web-sdk",
      "kind": "code",
      "include": [
        "sdk/web/src/**/*.ts",
        "sdk/web/src/**/*.tsx"
      ]
    },
    {
      "id": "react-native-sdk",
      "kind": "code",
      "include": [
        "sdk/react-native/src/**/*.ts",
        "sdk/react-native/src/**/*.tsx"
      ]
    },
    {
      "id": "unity-tier1",
      "kind": "code",
      "include": [
        "sdk/core/unity/Runtime/**/*.cs",
        "sdk/core/unity/Editor/**/*.cs"
      ]
    },
    {
      "id": "docs",
      "kind": "docs",
      "include": [
        "**/*.md"
      ]
    },
    {
      "id": "contract-sql",
      "kind": "contract",
      "include": [
        "services/mail-server/**/*.sql",
        "tools/sql/**/*.sql"
      ]
    },
    {
      "id": "sample-app",
      "kind": "contract",
      "include": [
        "sdk/samples/**",
        "sdk/adapter-samples/**",
        "sdk/core/ios/Demo/**",
        "sdk/**/Demo/**",
        "sdk/react-native/example/**",
        "sdk/core/android/strictmode-sample/**"
      ]
    },
    {
      "id": "sdk-scripts",
      "kind": "contract",
      "include": [
        "sdk/**/*.sh",
        "sdk/**/scripts/**"
      ]
    },
    {
      "id": "contract-iac",
      "kind": "contract",
      "include": [
        "monitoring/**/*.{yml,yaml,json}",
        "infrastructure/**/*.{yml,yaml,toml,conf,service,tf,tpl}",
        "**/Dockerfile*",
        "**/docker-compose*.yml",
        ".woodpecker/*.yml",
        ".github/**/*.{yml,yaml}",
        "**/Caddyfile",
        "**/*.proto",
        "**/cron/*",
        "infrastructure/hetzner/*.service",
        "docs/**/evidence/**/*.{yml,yaml}",
        "infrastructure/**/grafana/**/*.json",
        "services/mail-server/config/**/*.toml",
        "**/*.service"
      ]
    },
    {
      "id": "contract-site",
      "kind": "contract",
      "include": [
        "site/**"
      ]
    },
    {
      "id": "contract-build",
      "kind": "contract",
      "include": [
        "Makefile",
        "**/Cargo.toml",
        "Cargo.lock",
        "rust/Cargo.lock",
        "tools/coverage/*",
        "**/*.toml",
        "sdk/**/package.json",
        "sdk/**/build.gradle",
        "sdk/**/build.gradle.kts",
        "sdk/**/settings.gradle",
        "sdk/**/settings.gradle.kts",
        "sdk/**/gradle.properties",
        "sdk/**/*.properties",
        "sdk/**/*.pro",
        "sdk/**/Package.swift",
        "sdk/**/*.csproj",
        "sdk/**/*.asmdef",
        "sdk/**/pubspec.yaml",
        "sdk/**/tsconfig*.json",
        "sdk/**/*.config.cjs",
        "sdk/**/*.config.mjs",
        "sdk/**/rollup.config.mjs",
        "sdk/**/.eslintrc.json",
        "sdk/**/project.yml",
        "sdk/**/AndroidManifest.xml",
        "sdk/**/*.plist",
        "sdk/**/link.xml"
      ]
    }
  ],
  "exclusions": [
    {
      "glob": "**/*.d.ts",
      "code": "GENERATED"
    },
    {
      "glob": "LICENSE",
      "code": "NON_EXECUTABLE"
    },
    {
      "code": "BUILD_ARTIFACT",
      "glob": "**/package-lock.json"
    },
    {
      "glob": "**/CODEOWNERS",
      "code": "NON_EXECUTABLE"
    },
    {
      "glob": "**/*.png",
      "code": "NON_EXECUTABLE"
    },
    {
      "glob": "**/*.jpg",
      "code": "NON_EXECUTABLE"
    },
    {
      "glob": "**/*.jpeg",
      "code": "NON_EXECUTABLE"
    },
    {
      "glob": "**/*.svg",
      "code": "NON_EXECUTABLE"
    },
    {
      "glob": "**/*.ico",
      "code": "NON_EXECUTABLE"
    },
    {
      "glob": "**/*.gif",
      "code": "NON_EXECUTABLE"
    },
    {
      "glob": "**/*.webp",
      "code": "NON_EXECUTABLE"
    },
    {
      "glob": "**/*.woff2",
      "code": "NON_EXECUTABLE"
    },
    {
      "glob": "**/*.pdf",
      "code": "NON_EXECUTABLE"
    },
    {
      "glob": "**/*.txt",
      "code": "NON_EXECUTABLE"
    },
    {
      "glob": "**/.gitignore",
      "code": "NON_EXECUTABLE"
    },
    {
      "glob": "**/.dockerignore",
      "code": "NON_EXECUTABLE"
    },
    {
      "glob": "**/.gitkeep",
      "code": "NON_EXECUTABLE"
    },
    {
      "glob": "**/*.sln",
      "code": "NON_EXECUTABLE"
    },
    {
      "glob": "site/public/**",
      "code": "BUILD_ARTIFACT"
    },
    {
      "glob": "**/*.lock",
      "code": "BUILD_ARTIFACT"
    },
    {
      "glob": "**/*.parquet",
      "code": "DATA_ARTIFACT"
    },
    {
      "glob": "**/*.onnx",
      "code": "DATA_ARTIFACT"
    },
    {
      "glob": "**/*.pkl",
      "code": "DATA_ARTIFACT"
    },
    {
      "glob": "**/*.csv",
      "code": "DATA_ARTIFACT"
    },
    {
      "glob": "**/*.jsonl",
      "code": "DATA_ARTIFACT"
    },
    {
      "glob": "coverage-manifest.json",
      "code": "BUILD_ARTIFACT"
    },
    {
      "glob": "coverage-report.md",
      "code": "BUILD_ARTIFACT"
    },
    {
      "glob": "**/*.docx",
      "code": "NON_EXECUTABLE"
    },
    {
      "glob": "docs/**/*.json",
      "code": "DATA_ARTIFACT"
    },
    {
      "glob": "docs/**/*.log",
      "code": "NON_EXECUTABLE"
    },
    {
      "glob": "docs/**/*.html",
      "code": "SAMPLE_APP"
    },
    {
      "code": "NON_EXECUTABLE",
      "glob": "sdk/**/src/main/res/**"
    },
    {
      "code": "BUILD_ARTIFACT",
      "glob": "sdk/**/coverage/**"
    }
  ],
  "exclusionCodes": [
    "VENDOR",
    "GENERATED",
    "BUILD_ARTIFACT",
    "SAMPLE_APP",
    "DATA_ARTIFACT",
    "NON_EXECUTABLE"
  ]
}
