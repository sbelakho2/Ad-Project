{
  "__comment": "Policy tables for the coverage classifier (data, so prose-lint constants do not live in scanned code). DOMAINS: first-match-wins include/exclude patterns per domain. EXCLUSIONS: reason-coded file patterns checked before domains. tests in stack-integrity prove runtime parity.",
  "domains": [
    {
      "id": "meta-test",
      "kind": "test",
      "include": [
        "**/fixtures/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.js",
        "**/*.test.jsx",
        "**/*.test.mjs",
        "**/*.spec.ts",
        "**/*.spec.js",
        "**/*.spec.mjs",
        "**/*_test.go",
        "**/test_*.py",
        "**/*_test.py",
        "**/__tests__/**",
        "**/tests/**",
        "**/Tests/**",
        "**/src/test/**",
        "**/src/androidTest/**",
        "sdk/flutter/test/**",
        "**/*.bats",
        "**/__mocks__/**",
        "**/*.stories.tsx",
        "**/*.stories.ts",
        "**/*.stories.jsx",
        "**/playwright*.config.ts",
        "**/jest.setup.ts",
        "**/setupTests.ts",
        "**/.storybook/**",
        "**/docs/**/*.tsx"
      ]
    },
    {
      "id": "sample-app",
      "kind": "contract",
      "include": [
        "sdk/samples/**",
        "sdk/adapter-samples/**",
        "sdk/core/ios/Demo/**",
        "sdk/**/Demo/**",
        "sdk/react-native/example/**",
        "Test Apps/**"
      ]
    },
    {
      "id": "backend",
      "kind": "code",
      "include": [
        "backend/src/**/*.ts",
        "backend/routes/**/*.ts",
        "backend/services/**/*.ts",
        "backend/scripts/**/*.ts"
      ],
      "exclude": [
        "backend/src/openapi/**"
      ]
    },
    {
      "id": "backend-go",
      "kind": "code",
      "include": [
        "backend/auction/**/*.go",
        "backend/config/**/*.go",
        "backend/payments/**/*.go",
        "backend/router/**/*.go"
      ],
      "exclude": [
        "**/*_test.go"
      ]
    },
    {
      "id": "console",
      "kind": "code",
      "include": [
        "console/src/**/*.ts",
        "console/src/**/*.tsx",
        "console/scripts/**/*.ts"
      ],
      "exclude": [
        "console/src/tests/**"
      ]
    },
    {
      "id": "website",
      "kind": "code",
      "include": [
